# Copy to .env at the project root. .env is gitignored.

# Router provider: "anthropic" (default) or "groq".
# ROUTER_PROVIDER=anthropic

# Required when ROUTER_PROVIDER=anthropic, and for image understanding.
ANTHROPIC_API_KEY=

# Required when ROUTER_PROVIDER=groq, and for voice-note transcription.
GROQ_API_KEY=

# Optional alternative transcription backend.
OPENAI_API_KEY=

# Optional overrides.
# ANTHROPIC_ROUTER_MODEL=claude-sonnet-5
# GROQ_ROUTER_MODEL=openai/gpt-oss-120b
# ROUTER_WORKERS=8
# ATTENTION_ROUTER_DATA=/absolute/path/to/data
